<Window
    x:Class="AcerChargeLimiter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Acer Battery Optimizer">

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<Grid x:Name="RootGrid" Padding="24" RowSpacing="16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" Spacing="4">
				<TextBlock x:Name="TitleTextBlock" Style="{StaticResource TitleTextBlockStyle}"/>
				<TextBlock x:Name="SubtitleTextBlock"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
			</StackPanel>

			<StackPanel Grid.Row="1" Spacing="8">
				<InfoBar x:Name="UpdateInfoBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational">
					<InfoBar.ActionButton>
						<Button x:Name="UpdateActionButton" Click="OnUpdateNowClicked"/>
					</InfoBar.ActionButton>
				</InfoBar>

				<InfoBar x:Name="SupportInfoBar"
                         IsOpen="False"
                         IsClosable="True"
                         CloseButtonClick="OnSupportInfoBarClosed">
					<InfoBar.ActionButton>
						<DropDownButton x:Name="ReportDropDownButton" Visibility="Collapsed">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE9D9;" FontSize="14"/>
								<TextBlock x:Name="ReportButtonTextBlock"/>
							</StackPanel>
							<DropDownButton.Flyout>
								<MenuFlyout>
									<MenuFlyoutItem x:Name="ReportMenuItem" Click="OnReportCompatibilityClicked">
										<MenuFlyoutItem.Icon>
											<FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE8A7;"/>
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
									<MenuFlyoutItem x:Name="DontShowAgainMenuItem" Click="OnDontShowAgainClicked">
										<MenuFlyoutItem.Icon>
											<FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE711;"/>
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
								</MenuFlyout>
							</DropDownButton.Flyout>
						</DropDownButton>
					</InfoBar.ActionButton>
				</InfoBar>
			</StackPanel>

			<Border Grid.Row="2"
                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    VerticalAlignment="Top">

				<StackPanel Spacing="20">
					<Grid ColumnSpacing="16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" VerticalAlignment="Center">
							<TextBlock x:Name="ToggleTitleTextBlock" Style="{StaticResource SubtitleTextBlockStyle}"/>
							<TextBlock x:Name="ToggleDescTextBlock"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
						</StackPanel>

						<ToggleSwitch x:Name="BatteryLimitToggle"
                                      Grid.Column="1"
                                      IsEnabled="False"
                                      Toggled="OnBatteryLimitToggled"/>
					</Grid>

					<MenuFlyoutSeparator />

					<Grid ColumnSpacing="16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" VerticalAlignment="Center">
							<TextBlock x:Name="AutoStartTitleTextBlock" Style="{StaticResource SubtitleTextBlockStyle}"/>
							<TextBlock x:Name="AutoStartDescTextBlock"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
						</StackPanel>

						<ToggleSwitch x:Name="AutoStartToggle"
                                      Grid.Column="1"
                                      Toggled="OnAutoStartToggled"/>
					</Grid>

					<Border x:Name="StatusCard"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10">
						<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
							<FontIcon x:Name="StatusIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE862;" FontSize="16"/>
							<TextBlock x:Name="StatusTextBlock"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</Border>

			<StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Margin="0,12,0,0">

				<TextBlock x:Name="AppVersionTextBlock"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>

				<TextBlock Text="&#x2022;"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorDisabledBrush}"
                           VerticalAlignment="Center"/>

				<TextBlock x:Name="DevelopedByTextBlock"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>

				<Button x:Name="GithubButton"
                        Click="OnGithubClicked"
                        Padding="2"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        VerticalAlignment="Center">
					<Viewbox Width="14" Height="14" FlowDirection="LeftToRight">
